# =============================================================================
# Nihongo Master — Environment Variables
# =============================================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env with real credentials to version control.
# =============================================================================

# ─── Frontend (Vite) ────────────────────────────────────────────────────────
# Only VITE_ prefixed variables are exposed to the browser bundle.
# NEVER put API keys, database credentials, or secrets here.

# Backend API base URL (the frontend calls this)
VITE_API_URL=/api

# ─── Backend ────────────────────────────────────────────────────────────────
# These variables are ONLY available server-side. Never prefix with VITE_.

# Server
PORT=3001
NODE_ENV=development

# Database — TiDB Cloud (MySQL-compatible)
DATABASE_HOST=your-tidb-cluster.tidbcloud.com
DATABASE_PORT=4000
DATABASE_USER=your_user.root
DATABASE_PASSWORD=your_password
DATABASE_NAME=nihongo_master
DATABASE_SSL=true

# Authentication — JWT
JWT_SECRET=replace-with-a-strong-random-secret-min-32-chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# AI Service — Groq (server-side only, NEVER expose to browser)
GROQ_API_KEY=replace-with-your-groq-api-key

# CORS — Allowed frontend origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Dev-only: where the Vite dev server proxies /api (defaults to http://localhost:3001)
# VITE_DEV_API_TARGET=http://localhost:3001
# VITE_DEV_PORT=3000

# Dev-only demo sign-in button on the login page. Put REAL values only in a git-ignored
# `.env.local` — never commit them. Ignored (and stripped) in production builds.
# VITE_DEV_DEMO_EMAIL=
# VITE_DEV_DEMO_PASSWORD=
